{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./tf.cmd *)",
      "Bash(cmd //c tf.cmd *)",
      "PowerShell(.\\tf.cmd *)",
      "PowerShell(./tf.cmd *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git fetch*)",
      "PowerShell(git branch*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Edit(/Source/**)",
      "Edit(/Content/Data/**)",
      "Edit(/Config/**)",
      "Edit(/Scripts/**)",
      "Edit(/Tests/**)",
      "Edit(/docs/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git pull*)",
      "Bash(git merge *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "PowerShell(git push *)",
      "PowerShell(git pull*)",
      "PowerShell(git merge *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "Bash(winget *)",
      "PowerShell(winget *)",
      "Edit(/Content/**/*.uasset)",
      "Edit(/Content/**/*.umap)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git stash*)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git stash*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Edit(~/Documents/GitHub/**)"
    ]
  }
}
